{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.6.0",
  "description": "__MSG_appDescription__",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lunori",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate page / show original"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "default_locale": "en",
  "homepage_url": "https://lunori-translate.vercel.app"
}
